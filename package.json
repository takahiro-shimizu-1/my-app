{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker compose build",
    "docker:dev": "docker compose up app",
    "docker:shell": "docker compose run --rm workspace bash",
    "miyabi": "./scripts/miyabi-local.sh",
    "miyabi:doctor": "./scripts/miyabi-local.sh doctor",
    "miyabi:status": "./scripts/miyabi-local.sh status",
    "miyabi:cycle": "./scripts/miyabi-local.sh cycle status",
    "miyabi:bus:init": "./scripts/miyabi-local.sh bus init",
    "miyabi:bus:health": "./scripts/miyabi-local.sh bus health --update",
    "miyabi:bus:record-bootstrap": "./scripts/miyabi-local.sh bus record-run project-setup --task \"bootstrap my-app\" --result success --score 1",
    "asb:dashboard": "agent-skill-bus dashboard --data-dir .skill-bus --queue-dir queue --skills-dir monitor --kw-dir watcher",
    "state:check": "npx tsx scripts/label-state-machine.ts check",
    "state:transition": "npx tsx scripts/label-state-machine.ts transition",
    "state:assign-agent": "npx tsx scripts/label-state-machine.ts assign-agent",
    "project:status": "npx tsx scripts/update-project-status.ts",
    "report:weekly": "npx tsx scripts/generate-weekly-report.ts",
    "report:weekly:issue": "npx tsx scripts/generate-weekly-report.ts --create-issue",
    "report:kpi": "npx tsx scripts/post-kpi-report.ts",
    "agents:parallel:exec": "npx tsx scripts/agents-parallel-exec.ts",
    "gni:init": "./scripts/gni-safe.sh init",
    "gni:doctor": "./scripts/gni-safe.sh doctor",
    "gni:reindex": "./scripts/gni-safe.sh reindex"
  },
  "dependencies": {
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@octokit/graphql": "^8.2.1",
    "@octokit/rest": "^21.1.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "agent-skill-bus": "^1.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "miyabi": "^0.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
